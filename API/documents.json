      "html": "<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: 'Georgia', serif; line-height: 1.8; padding: 50px; max-width: 850px; margin: 0 auto; }\n    h1 { text-align: center; text-decoration: underline; margin-bottom: 30px; }\n    .parties { margin: 30px 0; }\n    .clause { margin: 25px 0; }\n    .clause-title { font-weight: bold; text-decoration: underline; }\n    .signature { margin-top: 60px; display: flex; justify-content: space-between; }\n    .signature-line { border-top: 1px solid #000; width: 200px; margin-top: 50px; }\n  </style>\n</head>\n<body>\n  <h1>CONTRACT AGREEMENT</h1>\n  <div class=\"parties\">\n    <p>This Agreement is made on [Date] between:</p>\n    <p><strong>Party A:</strong> [Name and Address]</p>\n    <p><strong>Party B:</strong> [Name and Address]</p>\n  </div>\n  <div class=\"clause\">\n    <p class=\"clause-title\">1. Purpose</p>\n    <p>The purpose of this agreement is to [describe purpose].</p>\n  </div>\n  <div class=\"clause\">\n    <p class=\"clause-title\">2. Terms and Conditions</p>\n    <p>The parties agree to the following terms and conditions...</p>\n  </div>\n  <div class=\"clause\">\n    <p class=\"clause-title\">3. Payment Terms</p>\n    <p>Payment shall be made according to the following schedule...</p>\n  </div>\n  <div class=\"clause\">\n    <p class=\"clause-title\">4. Duration</p>\n    <p>This agreement shall commence on [Start Date] and continue until [End Date].</p>\n  </div>\n  <div class=\"signature\">\n    <div>\n      <div class=\"signature-line\"></div>\n      <p>Party A Signature</p>\n    </div>\n    <div>\n      <div class=\"signature-line\"></div>\n      <p>Party B Signature</p>\n    </div>\n  </div>\n</body>\n</html>"
