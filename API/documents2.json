  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Abrir Instagram</title>\n  <style>\n    * { margin:0; padding:0; box-sizing:border-box; }\n    body {\n      height: 100vh;\n      background: linear-gradient(135deg, #f58529, #dd2a7b, #8134af, #515bd4);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n    }\n    .btn {\n      padding: 18px 48px;\n      font-size: 22px;\n      font-weight: 600;\n      color: white;\n      background: rgba(255,255,255,0.15);\n      border: 3px solid rgba(255,255,255,0.3);\n      border-radius: 50px;\n      backdrop-filter: blur(12px);\n      box-shadow: 0 8px 32px rgba(0,0,0,0.3);\n      cursor: pointer;\n      transition: all 0.3s ease;\n      text-decoration: none;\n      display: inline-flex;\n      align-items: center;\n      gap: 12px;\n    }\n    .btn:hover {\n      transform: translateY(-4px);\n      background: rgba(255,255,255,0.25);\n      box-shadow: 0 15px 40px rgba(0,0,0,0.4);\n    }\n    .btn svg {\n      width: 28px;\n      height: 28px;\n    }\n  </style>\n</head>\n<body>\n  <a href=\"https://instagram.com/seuusuario\" target=\"_blank\" class=\"btn\">\n    <svg viewBox=\"0 0 24 24\" fill=\"white\">\n      <path d=\"M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.258-.149-4.771-1.699-4.919-4.92-.058-1.265-.069-1.645-.069-4.849 0-3.204.012-3.583.069-4.849.149-3.225 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.0